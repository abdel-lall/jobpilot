# API only, except GEMINI_API_KEY, GEMINI_EMBEDDING_MODEL, and EMBEDDING_MODEL.
# portfolio-mcp also receives those three so a live search can embed the query.
# Never set any of these for the web app.
# GEMINI_MODEL defaults to gemini-2.5-flash when empty.
# JOB_ANALYSIS_MODEL is stub or gemini. Compose uses stub when it is unset.
# EMBEDDING_MODEL is stub or gemini. Compose uses stub when it is unset.
# GEMINI_EMBEDDING_MODEL overrides the embedding model id. The default is gemini-embedding-001.
GEMINI_API_KEY=
GEMINI_MODEL=
JOB_ANALYSIS_MODEL=
EMBEDDING_MODEL=
GEMINI_EMBEDDING_MODEL=

# API listen port.
PORT=3000

# Vite dev server proxy target. This is not exposed to browser code.
API_PROXY_TARGET=http://localhost:3000

# PostgreSQL connection string for Prisma in packages/database.
# Local Compose database. Not used by the web app.
DATABASE_URL=postgresql://postgres:jobpilot@localhost:5432/postgres

# API only. HS256 signing secret for access tokens. Not used by the web app.
JWT_SECRET=dev-only-change-me

# API only. Browser origin allowed to send credentialed CORS requests.
WEB_ORIGIN=http://localhost:5173

# Browser-visible API origin. Auth requests go here with credentials.
# Not a secret. Local Compose sets this to http://localhost:3000.
VITE_API_ORIGIN=http://localhost:3000

# portfolio-mcp only. The API and the web app do not receive these.
MCP_PORT=3010
MCP_SHARED_SECRET=dev-only-change-me
