{
  "name": "@jobpilot/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:auth": "vitest run --config vitest.auth.config.ts",
    "test:profile": "vitest run --config vitest.profile.config.ts",
    "test:resumes": "vitest run --config vitest.resumes.config.ts",
    "test:jobs": "vitest run --config vitest.jobs.config.ts",
    "test:tailored-resume": "vitest run --config vitest.tailored-resume.config.ts",
    "test:interview-plan": "vitest run --config vitest.interview-plan.config.ts"
  },
  "dependencies": {
    "@jobpilot/ai": "workspace:*",
    "@jobpilot/database": "workspace:*",
    "@jobpilot/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@prisma/adapter-pg": "7.10.0",
    "argon2": "0.44.0",
    "express": "^4.21.2",
    "jose": "^6.2.12",
    "multer": "2.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
